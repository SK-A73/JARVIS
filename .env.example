# ===================================================
# JARVIS - Configuration Environment Variables
# ===================================================

# Host & Server
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_ENV=development
JARVIS_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-secret
JARVIS_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers Configuration
# Supported providers: ollama | openai | anthropic | mock
DEFAULT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Cloud LLM Providers (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Database (SQLite default for local setup, or PostgreSQL connection string)
DATABASE_URL=sqlite:///./jarvis.db

# Storage & Sandboxed Workspaces
WORKSPACE_ROOT=./workspace_storage
MAX_COMMAND_TIMEOUT_SECONDS=60
DANGEROUS_COMMANDS_CONFIRMATION=true

# Multi-Device & Security
ALLOW_DEVICE_REGISTRATION=true
ADMIN_PASSWORD=jarvis_secure_admin_password_2026
DEVICE_HEARTBEAT_INTERVAL_SECONDS=30
DEVICE_OFFLINE_TIMEOUT_SECONDS=90

# Memory & Semantic Search
EMBEDDING_PROVIDER=local
MEMORY_SIMILARITY_THRESHOLD=0.65
MAX_RELEVANT_MEMORIES=8
